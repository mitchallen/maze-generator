{
  "name": "@mitchallen/maze-generator",
  "version": "0.1.30",
  "description": "maze generator",
  "main": "dist/maze-generator.js",
  "scripts": {
    "build": "node build.js",
    "lint": "eslint src/",
    "test": "node build.js && mocha --recursive --timeout 20000",
    "coverage": "node build.js && c8 --include='src/**' --reporter=lcovonly --reporter=text mocha --recursive --timeout 20000",
    "test-hexagon": "mocha --recursive test/hexagon/ --timeout 5000",
    "test-square": "mocha --recursive test/square/ --timeout 5000",
    "test-triangle": "mocha --recursive test/triangle/ --timeout 5000",
    "test-circle": "mocha --recursive test/circle/ --timeout 5000",
    "test-ascii": "mocha --recursive test/ascii/ --timeout 5000",
    "test-debug": "mocha -g '@DEBUG' --recursive --timeout 20000",
    "test-jenkins": "node build.js && mocha --recursive --timeout 20000 -R xunit test/ > test-reports.xml"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/mitchallen/maze-generator.git"
  },
  "author": "Mitch Allen <npm@mitchallen.com> (http://mitchallen.com)",
  "license": "MIT",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "devDependencies": {
    "c8": "^10.1.3",
    "esbuild": "^0.28.1",
    "eslint": "^10.4.1",
    "mocha": "^11.7.5",
    "should": "^10.0.0"
  },
  "dependencies": {
    "@mitchallen/connection-grid": "^0.1.34",
    "@mitchallen/connection-grid-square": "^0.1.17",
    "@mitchallen/grid": "^0.1.25",
    "@mitchallen/maze-generator-core": "^0.1.13",
    "@mitchallen/maze-generator-square": "^0.1.24"
  },
  "overrides": {
    "diff": "^8.0.3",
    "js-yaml": "^5.0.0",
    "minimatch": ">=3.1.4",
    "serialize-javascript": ">=7.0.5"
  }
}
