{
  "name": "@mitchallen/maze-generator",
  "version": "0.1.33",
  "description": "maze generator",
  "main": "dist/maze-generator.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node build.js",
    "lint": "eslint src/",
    "test": "node build.js && node --test 'test/**/*.js'",
    "coverage": "node build.js && node --test --experimental-test-coverage --test-coverage-include='src/**' --test-coverage-lines=100 --test-coverage-branches=100 --test-coverage-functions=100 'test/**/*.js'",
    "test-hexagon": "node --test 'test/hexagon/**/*.js'",
    "test-square": "node --test 'test/square/**/*.js'",
    "test-triangle": "node --test 'test/triangle/**/*.js'",
    "test-circle": "node --test 'test/circle/**/*.js'",
    "test-ascii": "node --test 'test/ascii/**/*.js'",
    "test-debug": "node --test --test-name-pattern='@DEBUG' 'test/**/*.js'",
    "test-jenkins": "node build.js && node --test --test-reporter=junit --test-reporter-destination=test-reports.xml 'test/**/*.js'"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/mitchallen/maze-generator.git"
  },
  "author": "Mitch Allen <npm@mitchallen.com> (http://mitchallen.com)",
  "license": "MIT",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "devDependencies": {
    "esbuild": "^0.28.1",
    "eslint": "^10.4.1"
  },
  "dependencies": {
    "@mitchallen/connection-grid": "^0.1.34",
    "@mitchallen/connection-grid-square": "^0.1.17",
    "@mitchallen/grid": "^0.1.25",
    "@mitchallen/maze-generator-core": "^0.1.13",
    "@mitchallen/maze-generator-square": "^0.1.24"
  }
}
